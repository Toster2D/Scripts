stepBox.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
stepBox.BorderSizePixel = 0
stepBox.TextColor3 = Color3.new(1, 1, 1)
stepBox.Font = Enum.Font.GothamBold
stepBox.TextSize = 12
stepBox.Text = "0"
stepBox.PlaceholderText = "0"
stepBox.ClearTextOnFocus = false
stepBox.Parent = stepRow
Instance.new("UICorner", stepBox).CornerRadius = UDim.new(0, 4)

-- Разрешаем только цифры и "."
stepBox:GetPropertyChangedSignal("Text"):Connect(function()
    local filtered = stepBox.Text:gsub("[^%d%.]", "")
    -- Только одна точка
    local dotCount = 0
    filtered = filtered:gsub("%.", function()
        dotCount = dotCount + 1
        return dotCount == 1 and "." or ""
    end)
    if stepBox.Text ~= filtered then
        stepBox.Text = filtered
    end
end)

local function getStep()
    local val = tonumber(stepBox.Text)
    if val and val > 0 then
        return val
    end
    return 0
end

local function snapToStep(value, step)
    if step <= 0 then return value end
    return math.round(value / step) * step
end

-- Handles и логика
local handles
local selectedBlock = nil
local selectedPPart = nil
local startDistance = 0
local startSize = Vector3.new()
local startCFrame = CFrame.new()
local dragging = false
local updateConn
local inputConn
local hoverConn

local hoverHighlight = Instance.new("Highlight")
hoverHighlight.Name = "NLHoverHighlight"
hoverHighlight.FillColor = Color3.fromRGB(255, 170, 0)
hoverHighlight.FillTransparency = 0.5
hoverHighlight.OutlineColor = Color3.fromRGB(255, 170, 0)
hoverHighlight.OutlineTransparency = 0
hoverHighlight.Enabled = false
hoverHighlight.Parent = game:GetService("CoreGui")

local hoveredBlock = nil

local function clearHover()
    hoverHighlight.Enabled = false
    hoverHighlight.Adornee = nil
    hoveredBlock = nil
end

local function updateHover()
    if selectedBlock then clearHover() return end
    local target = mouse.Target
    local block = target and target.Parent
    if block and block.Parent == blocksFolder and target.Name == "PPart" then
        if hoveredBlock ~= block then
            hoveredBlock = block
            hoverHighlight.Adornee = block
            hoverHighlight.Enabled = true
        end
    else
        clearHover()
    end
end

local function startUpdate()
    if updateConn then updateConn:Disconnect() end
    updateConn = RunService.RenderStepped:Connect(function()
        if selectedPPart then
            local s = selectedPPart.Size
            local p = selectedPPart.Position
            sizeLabel.Text = string.format("%.3f, %.3f, %.3f", s.X, s.Y, s.Z)
            posLabel.Text = string.format("%.3f, %.3f, %.3f", p.X, p.Y, p.Z)
        end
    end)
end

local function createHandles(ppart)
    if handles then handles:Destroy() end
    handles = Instance.new("Handles")
    handles.Name = "NLHandles"
    handles.Adornee = ppart
    handles.Color = BrickColor.new("CGA brown")
    handles.Style = Enum.HandlesStyle.Resize
    handles.Faces = Faces.new(
        Enum.NormalId.Front, Enum.NormalId.Back,
        Enum.NormalId.Left, Enum.NormalId.Right,
        Enum.NormalId.Top, Enum.NormalId.Bottom
    )
    handles.Parent = game:GetService("CoreGui")

    handles.MouseButton1Down:Connect(function()
        dragging = true
        startDistance = 0
        startSize = selectedPPart.Size
        startCFrame = selectedPPart.CFrame
    end)

    handles.MouseButton1Up:Connect(function()
        dragging = false
        startDistance = 0
    end)

    handles.MouseDrag:Connect(function(face, distance)
        if not dragging or not selectedPPart then return end
        pcall(function()
            local step = getStep()
            local rawDelta = (distance - startDistance) * 0.1
            local totalDelta = step > 0 and snapToStep(rawDelta, step) or rawDelta

            local faceNormals = {
                [Enum.NormalId.Right]  = startCFrame.RightVector,
                [Enum.NormalId.Left]   = -startCFrame.RightVector,
                [Enum.NormalId.Top]    = startCFrame.UpVector,
                [Enum.NormalId.Bottom] = -startCFrame.UpVector,
                [Enum.NormalId.Front]  = startCFrame.LookVector,
                [Enum.NormalId.Back]   = -startCFrame.LookVector,
            }

            local normal = faceNormals[face]
            if not normal then return end

            local sizeAxis = Vector3.new(
                (face == Enum.NormalId.Right or face == Enum.NormalId.Left) and totalDelta or 0,
                (face == Enum.NormalId.Top or face == Enum.NormalId.Bottom) and totalDelta or 0,
                (face == Enum.NormalId.Front or face == Enum.NormalId.Back) and totalDelta or 0
            )

            local newSize = Vector3.new(
                math.max(0.001, startSize.X + sizeAxis.X),
                math.max(0.001, startSize.Y + sizeAxis.Y),
                math.max(0.001, startSize.Z + sizeAxis.Z)
            )

            local deltaSize = newSize - startSize
            local offset = normal * (deltaSize.X + deltaSize.Y + deltaSize.Z) / 2
            local newCFrame = startCFrame + offset

            originalTool.RF:InvokeServer(selectedBlock, newSize, newCFrame)
        end)
    end)
end

function setupTool(tool)
    tool.Equipped:Connect(function()
        gui.Enabled = false

        inputConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            if dragging then return end

            local target = mouse.Target
            if not target then return end

            local block = target.Parent
            if block and block.Parent == blocksFolder and target.Name == "PPart" then
                selectedBlock = block
                selectedPPart = target
                sizeLabel.Text = "Selected: " .. block.Name
                gui.Enabled = true
                clearHover()
                createHandles(selectedPPart)
            end
        end)

        hoverConn = RunService.RenderStepped:Connect(updateHover)
        startUpdate()
    end)

    tool.Unequipped:Connect(function()
        gui.Enabled = false
        dragging = false
        if handles then handles:Destroy() handles = nil end
        if updateConn then updateConn:Disconnect() updateConn = nil end
        if inputConn then inputConn:Disconnect() inputConn = nil end
        if hoverConn then hoverConn:Disconnect() hoverConn = nil end
        clearHover()
        selectedBlock = nil
        selectedPPart = nil
    end)
end

setupTool(fakeTool)
