local SCRIPT_URL = "https://raw.githubusercontent.com/Toster2D/Scripts/refs/heads/main/AppleNatortest"
local PLACE_ID = 6403373529
local PLATFORM_POS = Vector3.new(5000, 229, -9000)
local BATCH_SIZE = 20      -- сколько серверов в одном списке, потом берём новый список
local RETRY_DELAY = 20     -- пауза, если серверов не нашлось
local TP_TIMEOUT = 10      -- сколько ждём результата телепорта, потом берём следующий сервер
local STATE_FILE = "AppleNator_servers.json"

-- Автозапуск после телепорта
local queue_on_teleport = queue_on_teleport or queueonteleport
if queue_on_teleport then
    queue_on_teleport(([[
        if not game:IsLoaded() then game.Loaded:Wait() end
        task.wait(2)
        pcall(function()
            loadstring(game:HttpGet("%s"))()
        end)
    ]]):format(SCRIPT_URL))
end

if not game:IsLoaded() then
    game.Loaded:Wait()
end

if game.PlaceId ~= PLACE_ID then return end

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart", 15)
if not hrp then return end

local function touch(part)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and part then
        firetouchinterest(root, part, 0)
        firetouchinterest(root, part, 1)
    end
end

local function hasEntered()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("entered")
end

task.wait(1)

-- 1. Платформа
local platform = Instance.new("Part")
platform.Name = "MyPlatform"
platform.Size = Vector3.new(200, 10, 200)
platform.Transparency = 0.5
platform.CanCollide = true
platform.Anchored = true
platform.Position = PLATFORM_POS
platform.Parent = workspace

-- 2. Вход в арену + телепорт на платформу
if not hasEntered() then
    local timeout = 0
    repeat
        task.wait(0.1)
        timeout += 0.1
        local lobby = workspace:FindFirstChild("Lobby")
        local tp1 = lobby and lobby:FindFirstChild("Teleport1")
        if tp1 and timeout % 1 < 0.1 then
            touch(tp1)
        end
    until hasEntered() or timeout > 15

    if hasEntered() then
        task.wait(0.5)
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.CFrame = CFrame.new(PLATFORM_POS + Vector3.new(0, 8, 0))
        end
    end
end

-- 3. Сбор Slapples
local arena = workspace:FindFirstChild("Arena") or workspace:WaitForChild("Arena", 10)
local island = arena and arena:FindFirstChild("island5")
local slapples = island and island:FindFirstChild("Slapples")
if slapples then
    for _, v in ipairs(slapples:GetDescendants()) do
        if v.Name == "Glove" and v:FindFirstChildWhichIsA("TouchTransmitter") then
            touch(v)
        end
    end
end

-- 4. Серверхоп со списком серверов
-- Список хранится в файле (переживает телепорт). Если файлов нет — в getgenv.
local function loadState()
    local raw
    if readfile and isfile then
        pcall(function()
            if isfile(STATE_FILE) then raw = readfile(STATE_FILE) end
        end)
    end
    if not raw and getgenv then
        raw = getgenv().AppleNator_state
    end
    if raw then
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(data) == "table" and type(data.servers) == "table" then
            return data
        end
    end
    return {servers = {}}
end

local function saveState(state)
    local raw = HttpService:JSONEncode(state)
    local saved = false
    if writefile then
        saved = pcall(writefile, STATE_FILE, raw)
    end
    if not saved and getgenv then
        getgenv().AppleNator_state = raw
    end
end

local function fetchServers()
    local ok, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. PLACE_ID
            .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or type(result) ~= "table" or type(result.data) ~= "table" then
        return {}
    end

    local list = {}
    for _, v in ipairs(result.data) do
        if type(v) == "table"
            and tonumber(v.playing) and tonumber(v.maxPlayers)
            and v.playing < v.maxPlayers
            and v.id ~= game.JobId then
            list[#list + 1] = v.id
        end
    end

    -- перемешиваем и берём не больше BATCH_SIZE
    for i = #list, 2, -1 do
        local j = math.random(1, i)
        list[i], list[j] = list[j], list[i]
    end
    while #list > BATCH_SIZE do
        table.remove(list)
    end
    return list
end

-- Берёт следующий сервер из списка; если список закончился — запрашивает новый
local function nextServer()
    local state = loadState()
    if #state.servers == 0 then
        state.servers = fetchServers()
    end
    local id = table.remove(state.servers, 1)
    saveState(state)
    return id
end

local tpFailed = false
TeleportService.TeleportInitFailed:Connect(function(player)
    if player == LocalPlayer then
        tpFailed = true
    end
end)

while true do
    local id = nextServer()
    if not id then
        task.wait(RETRY_DELAY) -- серверов нет, пробуем получить новый список позже
    elseif id ~= game.JobId then
        tpFailed = false
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, id, LocalPlayer)
        end)
        if ok then
            local waited = 0
            while not tpFailed and waited < TP_TIMEOUT do
                task.wait(0.25)
                waited += 0.25
            end
        end
        -- если телепорт удался, скрипт перезапустится на новом сервере;
        -- иначе (полный сервер, ошибка) цикл берёт следующий сервер
    end
end
