-- Функция сервер-хопа (как в Infinite Yield)
local function serverHop(placeId)
    placeId = placeId or game.PlaceId

    -- Поддержка разных эксплойтов
    local req = (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request) or request
    if not req then
        -- Если эксплойт не поддерживает HTTP-запросы, делаем обычный телепорт
        warn("HTTP request not supported. Using basic teleport.")
        TeleportService:Teleport(placeId)
        return
    end

    local servers = {}
    local cursor = ""

    while true do
        local url = string.format("https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Desc&limit=100%s", placeId, cursor ~= "" and "&cursor="..cursor or "")
        local success, response = pcall(function()
            return req({
                Url = url,
                Method = "GET"
            })
        end)

        if not success or not response or not response.Body then break end

        local body = HttpService:JSONDecode(response.Body)
        if not body or not body.data then break end

        for _, server in ipairs(body.data) do
            if type(server) == "table" and server.id and server.playing < server.maxPlayers then
                if server.id ~= game.JobId then
                    table.insert(servers, server.id)
                end
            end
        end

        if #servers > 0 then
            -- Выбираем случайный сервер из найденных
            local randomServer = servers[math.random(1, #servers)]
            pcall(function()
                TeleportService:TeleportToPlaceInstance(placeId, randomServer, LocalPlayer)
            end)
            break
        end

        cursor = body.nextPageCursor
        if not cursor then break end
        task.wait(0.1) -- Небольшая задержка, чтобы не словить рейт-лимит
    end

    -- Если серверов не найдено или API недоступно, используем запасной телепорт
    if #servers == 0 then
        warn("No available servers found via API. Using basic teleport.")
        TeleportService:Teleport(placeId)
    end
end

-- Запуск сервер-хопа в зависимости от текущего места
if game.PlaceId == id1 then
    serverHop(id2)
elseif game.PlaceId == id2 then
    serverHop(id3)
elseif game.PlaceId == id3 then
    serverHop(id1)
end
