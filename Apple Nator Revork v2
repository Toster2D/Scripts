local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local supportedPlaceIds = {
    [6403373529] = true,
    [9015014224] = true,
    [11520107397] = true
}

local id1 = 6403373529
local id2 = 9015014224
local id3 = 11520107397

local function cacheKey(placeId)
    return "ServerCache_" .. tostring(placeId)
end

local function fetchServers(placeId)
    local servers = {}
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(placeId)
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and res and res.data then
        for _, s in ipairs(res.data) do
            if s.playing < s.maxPlayers then
                table.insert(servers, s.id)
            end
        end
    end
    print("[API ЗАПРОС] place:", placeId, "получено серверов:", #servers)
    return servers
end

local function getServerList(placeId)
    local key = cacheKey(placeId)
    local cache = TeleportService:GetTeleportSetting(key)
    if not cache or #cache == 0 then
        print("[КЭША НЕТ] place:", placeId, "-> делаем запрос")
        cache = fetchServers(placeId)
    else
        print("[КЭШ ЕСТЬ] place:", placeId, "осталось серверов:", #cache)
    end
    return cache
end

local function popServer(placeId)
    local list = getServerList(placeId)
    if #list == 0 then return nil, list end
    local jobId = table.remove(list, 1)
    return jobId, list
end

local function nextPlace(pid)
    return (pid == id1 and id2) or (pid == id2 and id3) or id1
end

local MAX_ATTEMPTS = 10

local function teleportToFreshServer(placeId, attempt)
    attempt = attempt or 1
    if attempt > MAX_ATTEMPTS then
        print("[КРИТИЧЕСКАЯ ОШИБКА] превышен лимит попыток, обычный Teleport")
        pcall(function() TeleportService:Teleport(placeId) end)
        return
    end

    local jobId, remaining = popServer(placeId)

    if jobId then
        TeleportService:SetTeleportSetting(cacheKey(placeId), remaining)
        print("[ТЕЛЕПОРТ] попытка:", attempt, "place:", placeId, "jobId:", jobId, "останется в кэше:", #remaining)

        pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        end)

        task.wait(8) -- если скрипт всё ещё выполняется через 8 сек — телепорт не сработал

        print("[ТАЙМАУТ] за 8 сек не улетело, пробуем следующий jobId, попытка:", attempt + 1)
        teleportToFreshServer(placeId, attempt + 1)
    else
        print("[ФОЛЛБЕК] place:", placeId, "кэш пуст, обычный Teleport")
        pcall(function() TeleportService:Teleport(placeId) end)
    end
end

