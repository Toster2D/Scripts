-- Функция Server Hop
local function serverHop()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then
        warn("Ваш эксплойт не поддерживает HTTP запросы для Server Hop!")
        return
    end

    local placeId = game.PlaceId
    local currentJobId = game.JobId

    while true do
        local cursor = ""
        local hopped = false

        while not hopped do
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end

            local success, response = pcall(function()
                return req({
                    Url = url,
                    Method = "GET"
                })
            end)

            if success and response.StatusCode == 200 then
                local body = HttpService:JSONDecode(response.Body)
                if body.data and #body.data > 0 then
                    local validServers = {}
                    
                    for _, server in ipairs(body.data) do
                        if server.playing < server.maxPlayers and server.id ~= currentJobId then
                            table.insert(validServers, server.id)
                        end
                    end

                    if #validServers > 0 then
                        local randomServer = validServers[math.random(1, #validServers)]
                        
                        local tpSuccess, tpErr = pcall(function()
                            TeleportService:TeleportToPlaceInstance(placeId, randomServer, LocalPlayer)
                        end)
                        
                        if not tpSuccess then
                            warn("Ошибка телепорта: " .. tostring(tpErr) .. ". Ищем другой сервер...")
                            task.wait(1)
                        else
                            -- Проверяем телепорт каждые 0.5 сек в течение 5 секунд
                            local timeout = 0
                            while timeout < 5 do
                                task.wait(0.5)
                                timeout = timeout + 0.5
                                if game.JobId ~= currentJobId then
                                    hopped = true
                                    break
                                end
                            end
                            
                            if not hopped then
                                warn("Телепорт сорвался (сервер полный). Повторная попытка найти сервер...")
                                task.wait(0.5)
                            end
                        end
                    else
                        if body.nextPageCursor then
                            cursor = body.nextPageCursor
                        else
                            cursor = ""
                            task.wait(1)
                        end
                    end
                else
                    cursor = ""
                    task.wait(1)
                end
            elseif success and response.StatusCode == 429 then
                -- Роблокс заблокировал запрос из-за лимитов (2 бота с одного IP)
                warn("Rate Limit (429): Слишком много запросов. Ждем 5 секунд перед повтором...")
                task.wait(5)
            else
                task.wait(1)
            end
        end
        
        if hopped then break end
    end
end

serverHop()
