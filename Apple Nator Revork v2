if not game:IsLoaded() then
    game.Loaded:Wait()
end

local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local supportedPlaceIds = {
    [6403373529] = true,
    [9015014224] = true,
    [11520107397] = true
}

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart", 10)
if not hrp then return end

task.wait(0.5)

if supportedPlaceIds[game.PlaceId] then
    local safeportCFrame = CFrame.new(2457.6001, 229.365677, -4558.22363, -0.999834299, 0.000101457415, 0.0182033889, 3.8126462e-08, 0.999984503, -0.00557136489, -0.018203672, -0.00557044102, -0.999818802)

    local safeport = Instance.new("Part", workspace)
