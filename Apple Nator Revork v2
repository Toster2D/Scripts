if character:FindFirstChild("entered") == nil then
    local lobby = workspace:WaitForChild("Lobby", 5)
    if lobby then
        local teleport1 = lobby:WaitForChild("Teleport1", 5)
        if teleport1 then
            local timeout = 0
            repeat task.wait(0.1)
                timeout = timeout + 0.1
                if character:FindFirstChild("HumanoidRootPart") then
                    firetouchinterest(character.HumanoidRootPart, teleport1, 0)
                    firetouchinterest(character.HumanoidRootPart, teleport1, 1)
                end
            until character:FindFirstChild("entered") or timeout > 5
        end
    end
