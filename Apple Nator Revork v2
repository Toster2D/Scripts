if supportedPlaceIds[game.PlaceId] then
    if character and character:FindFirstChild("HumanoidRootPart") then
        local teleportCFrame = CFrame.new(2461.50464, 243.291565, -4546.78467, 0.966821849, -0.00649187574, 0.255369186, -1.00234743e-09, 0.999677002, 0.0254133251, -0.255451679, -0.0245701578, 0.966509581)
        character.HumanoidRootPart.CFrame = teleportCFrame
    end
end

task.wait(0.5)

local arena = workspace:WaitForChild("Arena", 5)
if arena then
    local island5 = arena:WaitForChild("island5", 5)
    if island5 then
        local slapples = island5:FindFirstChild("Slapples")
        if slapples then
            for _, v in ipairs(slapples:GetDescendants()) do
                if v.Name == "Glove" and v:FindFirstChildWhichIsA("TouchTransmitter") then
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        firetouchinterest(character.HumanoidRootPart, v, 0)
                        firetouchinterest(character.HumanoidRootPart, v, 1)
                    end
                end
            end
        end
    end
end

task.wait(math.random(1, 3))

local function serverHop()
    print("[SERVERHOP] Запуск функции serverHop...")
    
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then
        warn("[SERVERHOP] ОШИБКА: Эксплойт не имеет функции request!")
        return
    end
    print("[SERVERHOP] Функция request найдена.")

    local placeId = game.PlaceId
    local currentJobId = game.JobId

    while true do
        local cursor = ""
        local hopped = false

        while not hopped do
            -- Возвращаем оригинальный домен Роблокса
            local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end

            print("[SERVERHOP] Отправка запроса к API...")
            local success, response = pcall(function()
                return req({
                    Url = url,
                    Method = "GET"
                })
            end)

            if not success then
                warn("[SERVERHOP] Ошибка pcall при запросе: " .. tostring(response))
                task.wait(2)
            elseif response.StatusCode ~= 200 then
                warn("[SERVERHOP] API вернул код: " .. tostring(response.StatusCode) .. " | Тело: " .. tostring(response.Body))
                if response.StatusCode == 429 then
                    task.wait(math.random(3, 6))
                else
                    task.wait(2)
                end
            else
                print("[SERVERHOP] Сервера получены. Парсинг JSON...")
                local okParse, body = pcall(function()
                    return HttpService:JSONDecode(response.Body)
                end)

                if not okParse then
                    warn("[SERVERHOP] Ошибка парсинга JSON: " .. tostring(body))
                    task.wait(2)
                elseif not body.data or #body.data == 0 then
                    warn("[SERVERHOP] Список серверов пуст.")
                    task.wait(2)
                else
                    local validServers = {}
                    for _, server in ipairs(body.data) do
                        if server.playing < server.maxPlayers and server.id ~= currentJobId then
                            table.insert(validServers, server.id)
                        end
                    end

                    if #validServers > 0 then
                        local randomServer = validServers[math.random(1, #validServers)]
                        print("[SERVERHOP] Найден сервер! Попытка телепорта в JobId: " .. randomServer)

                        local tpSuccess, tpErr = pcall(function()
                            TeleportService:TeleportToPlaceInstance(placeId, randomServer, LocalPlayer)
                        end)

                        if not tpSuccess then
                            warn("[SERVERHOP] Ошибка TeleportService: " .. tostring(tpErr))
                            task.wait(1)
                        else
                            print("[SERVERHOP] Телепорт вызван. Ждем завершения...")
                            local timeout = 0
                            while timeout < 8 do
                                task.wait(0.5)
                                timeout = timeout + 0.5
                                if game.JobId ~= currentJobId then
                                    print("[SERVERHOP] Успех! Сменили сервер.")
                                    hopped = true
                                    break
                                end
                            end
                            
                            if not hopped then
                                warn("[SERVERHOP] Телепорт не сработал за 8 секунд. Ищем другой...")
                                task.wait(1)
                            end
                        end
                    else
                        if body.nextPageCursor then
                            cursor = body.nextPageCursor
                            print("[SERVERHOP] Нет свободных мест, переходим на след. страницу...")
                        else
                            cursor = ""
                            print("[SERVERHOP] Нет свободных мест и страниц нет. Ждем...")
                            task.wait(2)
                        end
                    end
                end
            end
        end
        
        if hopped then break end
    end
end

serverHop()
