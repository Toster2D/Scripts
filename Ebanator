-- AppleNator GUI: авто-портал, телепорт на платформу/координаты, спам клавиш
-- RightShift = скрыть/показать GUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local LP = Players.LocalPlayer

local PLATFORM_POS = Vector3.new(5000, 229, -9000)
local PLATFORM_TP_OFFSET = Vector3.new(0, 8, 0)

local cfg = {
    autoPortal = false,
    autoTP = false,
    useCustom = false,          -- false = платформа, true = свои координаты
    customPos = Vector3.new(0, 100, 0),
    platformOn = false,         -- создавать платформу под точкой (по умолчанию выкл)
    spam = false,
    freeze = false,
    autoReset = false,
    portalDelay = 0.1,   -- пауза между касаниями портала
    tpDelay = 0.1,       -- пауза после входа в арену перед ТП
    resetDelay = 0.1,    -- пауза после последнего шага перед ресетом
    interval = 0.05,
    keys = {"LMB", "E"},        -- жмутся одновременно
}

if getgenv and getgenv().AppleGUI then
    pcall(function() getgenv().AppleGUI:Destroy() end)
end

---------------------------------------------------------------- helpers
local function touch(part)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and part and part.Parent and firetouchinterest then
        pcall(function()
            firetouchinterest(root, part, 0)
            firetouchinterest(root, part, 1)
        end)
    end
end

local function hasEntered()
    local char = LP.Character
    return char and char:FindFirstChild("entered") ~= nil
end

local function targetPos()
    if cfg.useCustom then return cfg.customPos end
    return PLATFORM_POS + PLATFORM_TP_OFFSET
end

local frozenCF, savedWS, savedJP
local platform
local function removePlatform()
    if platform then platform:Destroy() platform = nil end
end

local function ensurePlatform(tpPos)
    if not platform or not platform.Parent then
        platform = Instance.new("Part")
        platform.Name = "MyPlatform"
        platform.Size = Vector3.new(200, 10, 200)
        platform.Transparency = 0.5
        platform.Anchored = true
        platform.CanCollide = true
        platform.Parent = workspace
    end
    platform.Position = tpPos - PLATFORM_TP_OFFSET
end

local function updatePlatform()
    if cfg.platformOn then ensurePlatform(targetPos()) else removePlatform() end
end

local function tpTo(pos, forcePlatform)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if forcePlatform or cfg.platformOn then ensurePlatform(pos) else removePlatform() end
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = CFrame.new(pos)
    if cfg.freeze then frozenCF = CFrame.new(pos) end
end

local function teleportNow() -- для авто-ТП
    tpTo(targetPos(), not cfg.useCustom)
end

local function parseKeys(s)
    local out = {}
    for tok in tostring(s):gmatch("[^%+%s,]+") do
        local u = tok:upper()
        if u == "LMB" or u == "MOUSEBUTTON1" then
            out[#out + 1] = "LMB"
        elseif u == "RMB" or u == "MOUSEBUTTON2" then
            out[#out + 1] = "RMB"
        else
            for _, k in ipairs(Enum.KeyCode:GetEnumItems()) do
                if k.Name:upper() == u then out[#out + 1] = k.Name break end
            end
        end
    end
    return out
end

local function send(k, down)
    if k == "LMB" then
        local char = LP.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            if down then tool:Activate() end
            return
        end
        local m = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(m.X, m.Y, 0, down, game, 0)
    elseif k == "RMB" then
        local m = UIS:GetMouseLocation()
        VIM:SendMouseButtonEvent(m.X, m.Y, 1, down, game, 0)
    else
        local kc = Enum.KeyCode[k]
        if kc then VIM:SendKeyEvent(down, kc, false, game) end
    end
end

-- Фриз
local function getParts()
    local char = LP.Character
    return char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart")
end

local function applyFreeze()
    local hum, root = getParts()
    if not (hum and root) then return end
    frozenCF = root.CFrame
    if hum.WalkSpeed > 0 then savedWS = hum.WalkSpeed end
    if hum.JumpPower > 0 then savedJP = hum.JumpPower end
    hum.WalkSpeed = 0
    hum.JumpPower = 0
end

local function removeFreeze()
    frozenCF = nil
    local hum = getParts()
    if hum then
        hum.WalkSpeed = savedWS or 16
        hum.JumpPower = savedJP or 50
    end
end

game:GetService("RunService").Heartbeat:Connect(function()
    if not (cfg.freeze and frozenCF) then return end
    local hum, root = getParts()
    if not (hum and root) then return end
    if hum.WalkSpeed ~= 0 then hum.WalkSpeed = 0 end
    root.AssemblyLinearVelocity = Vector3.zero
    root.CFrame = frozenCF
end)

-- Авто-ресет
local resetAt
local sinceTouch = 0
local function armReset()
    resetAt = cfg.autoReset and (os.clock() + cfg.resetDelay) or nil
end

local function resetCharacter()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 end
    if char then pcall(function() char:BreakJoints() end) end
end

LP.CharacterAdded:Connect(function()
    sinceTouch = 0
    if not (cfg.autoPortal or cfg.autoTP) then armReset() end
    if cfg.freeze then
        task.wait(0.5)
        applyFreeze()
    end
end)

