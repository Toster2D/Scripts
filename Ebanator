local function label(text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 16)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(170, 170, 185)
    l.Font = Enum.Font.Gotham
    l.TextSize = 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = list
    return l
end

local function button(text, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 28)
    b.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 13
    b.AutoButtonColor = true
    b.Parent = list
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            cb(b)
        end
    end)
    return b
end

local refreshers = {}
local function toggle(text, key, onChange)
    local b
    local function refresh()
        b.Text = text .. ": " .. (cfg[key] and "ВКЛ" or "ВЫКЛ")
        b.BackgroundColor3 = cfg[key] and Color3.fromRGB(40, 130, 70) or Color3.fromRGB(55, 55, 68)
    end
    refreshers[key] = function() refresh() end
    b = button(text, function()
        cfg[key] = not cfg[key]
        refresh()
        if onChange then onChange(cfg[key]) end
    end)
    refresh()
    return b
end

local function box(parentObj, text, size, pos)
    local t = Instance.new("TextBox")
    t.Size = size
    t.Position = pos or UDim2.new()
    t.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    t.BorderSizePixel = 0
    t.Text = text
    t.TextColor3 = Color3.new(1, 1, 1)
    t.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.ClearTextOnFocus = false
    t.Parent = parentObj
    Instance.new("UICorner", t).CornerRadius = UDim.new(0, 6)
    return t
end

