local bindBtn
bindBtn = button("Бинд: добавить следующую клавишу", function()
    bindBtn.Text = "Нажми клавишу/кнопку мыши..."
    local conn
    conn = UIS.InputBegan:Connect(function(input)
        local name
        if input.UserInputType == Enum.UserInputType.Keyboard then
            name = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            name = "LMB"
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            name = "RMB"
        end
        if name then
            conn:Disconnect()
            if not table.find(cfg.keys, name) then table.insert(cfg.keys, name) end
            keysBox.Text = table.concat(cfg.keys, "+")
            bindBtn.Text = "Бинд: добавить следующую клавишу"
        end
    end)
end)

button("Очистить клавиши", function()
