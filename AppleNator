local function touch(part)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and part then
        firetouchinterest(root, part, 0)
        firetouchinterest(root, part, 1)
    end
end

local function hasEntered()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("entered")
end

task.wait(1)

local platform = Instance.new("Part")
platform.Name = "MyPlatform"
platform.Size = Vector3.new(200, 10, 200)
platform.Transparency = 0.5
platform.CanCollide = true
platform.Anchored = true
platform.Position = PLATFORM_POS
platform.Parent = workspace

if not hasEntered() then
    log("вход в арену через Teleport1...")
    local timeout = 0
    repeat
        task.wait(0.1)
        timeout += 0.1
        local lobby = workspace:FindFirstChild("Lobby")
        local tp1 = lobby and lobby:FindFirstChild("Teleport1")
        if tp1 and timeout % 1 < 0.1 then
            touch(tp1)
        end
