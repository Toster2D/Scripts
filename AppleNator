local function countKeys(t)
    local n = 0
    for _ in pairs(t) do n += 1 end
    return n
end

local function loadState()
    local raw
    if readfile and isfile then
        pcall(function()
            if isfile(STATE_FILE) then raw = readfile(STATE_FILE) end
        end)
    end
    if not raw and getgenv then
        raw = getgenv().AppleNator_state
    end
    if raw then
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(data) == "table" and type(data.servers) == "table" then
            data.visited = type(data.visited) == "table" and data.visited or {}
            data.batch = tonumber(data.batch) or 0
            data.hops = tonumber(data.hops) or 0
            return data
        end
    end
    return {servers = {}, visited = {}, batch = 0, hops = 0}
end

local function saveState(state)
    local raw = HttpService:JSONEncode(state)
    local saved = false
    if writefile then
        saved = pcall(writefile, STATE_FILE, raw)
    end
    if not saved and getgenv then
        getgenv().AppleNator_state = raw
    end
end

-- Возвращает список id и статистику {total, skipped, err}
local function fetchServers(visited)
    local stats = {total = 0, skipped = 0}
    local ok, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. PLACE_ID
            .. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok then
        stats.err = tostring(result)
        return {}, stats
    end
    if type(result) ~= "table" or type(result.data) ~= "table" then
        stats.err = "неожиданный ответ API"
        return {}, stats
    end

    local list = {}
    for _, v in ipairs(result.data) do
        if type(v) == "table"
            and tonumber(v.playing) and tonumber(v.maxPlayers)
            and v.playing < v.maxPlayers
            and v.id ~= game.JobId then
            stats.total += 1
            if visited[v.id] then
                stats.skipped += 1
            else
                list[#list + 1] = v.id
            end
        end
    end

    -- перемешиваем и берём не больше BATCH_SIZE
    for i = #list, 2, -1 do
        local j = math.random(1, i)
        list[i], list[j] = list[j], list[i]
    end
    while #list > BATCH_SIZE do
        table.remove(list)
    end
    return list, stats
end

local function nextServer()
    local state = loadState()
    state.visited[game.JobId] = true -- текущий сервер уже посещён

    if #state.servers == 0 then
        local visitedCount = countKeys(state.visited)
        log("список пуст, запрашиваю новую пачку (исключаю посещённых:", visitedCount, ")")
        local list, stats = fetchServers(state.visited)
        state.servers = list
        state.batch += 1
        state.visited = {[game.JobId] = true}

        if stats.err then
            log("пачка #" .. state.batch, "| ошибка запроса:", stats.err)
        else
            log("пачка #" .. state.batch, "| найдено подходящих:", stats.total,
                "| пропущено посещённых:", stats.skipped, "| в пачке:", #list)
            if #list > 0 then
                log("серверы пачки:", table.concat(list, ", "))
            end
        end
    end

    local id = table.remove(state.servers, 1)
    if id then
        state.visited[id] = true
        state.hops += 1
        log("следующий сервер:", id, "| переход №" .. state.hops,
            "| осталось в пачке #" .. state.batch .. ":", #state.servers)
    end
    saveState(state)
    return id
end

local tpFailed = false
TeleportService.TeleportInitFailed:Connect(function(player, result, message)
    if player == LocalPlayer then
        tpFailed = true
        log("ошибка телепорта:", tostring(result), "|", tostring(message))
    end
end)

while true do
    local id = nextServer()
    if not id then
        log("серверов нет, повтор через", RETRY_DELAY, "сек")
        task.wait(RETRY_DELAY) -- серверов нет, пробуем получить новый список позже
    elseif id ~= game.JobId then
        tpFailed = false
        log("телепорт на", id, "| сейчас на JobId:", game.JobId)
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, id, LocalPlayer)
        end)
        if not ok then
            log("ошибка вызова телепорта:", tostring(err))
        else
            local waited = 0
            while not tpFailed and waited < TP_TIMEOUT do
                task.wait(0.25)
                waited += 0.25
            end
            if not tpFailed then
                log("тайм-аут телепорта, беру следующий сервер")
            end
        end
    end
end
