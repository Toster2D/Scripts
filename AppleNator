local SCRIPT_URL = "https://raw.githubusercontent.com/Toster2D/Scripts/refs/heads/main/AppleNatortest"
local PLACE_ID = 6403373529
local PLATFORM_POS = Vector3.new(5000, 229, -9000)
local BATCH_SIZE = 40      -- сколько серверов в одном списке, потом берём новый список
local RETRY_DELAY = 20     -- пауза, если серверов не нашлось
local TP_TIMEOUT = 10      -- сколько ждём результата телепорта, потом берём следующий сервер
local STATE_FILE = "AppleNator_servers.json"
local LOGS = false          -- true = писать логи в консоль (F9), false = выключить

local function log(...)
    if LOGS then
        print("[AppleNator]", ...)
    end
end

