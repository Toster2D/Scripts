---------------------------------------------------------------- Горячие клавиши
UIS.InputBegan:Connect(function(input, _gp)
    if input.KeyCode == Enum.KeyCode.Delete then
        cfg.spam = false
        if refreshers.spam then refreshers.spam() end
    elseif input.KeyCode == Enum.KeyCode.RightControl then
        cfg.spam = not cfg.spam
        if refreshers.spam then refreshers.spam() end
    end
end)

local function mouseOverGui()
    if not gui.Enabled then return false end
    local m = UIS:GetMouseLocation()
    local p, sz = frame.AbsolutePosition, frame.AbsoluteSize
    return m.X >= p.X and m.X <= p.X + sz.X and m.Y >= p.Y and m.Y <= p.Y + sz.Y
end

---------------------------------------------------------------- Loops
task.spawn(function()
    local wasEntered = false
    while gui.Parent do
        task.wait(0.05)
        local entered = hasEntered() and true or false

        if cfg.autoPortal and not entered then
            sinceTouch += 0.05
            if sinceTouch >= cfg.portalDelay then
                sinceTouch = 0
                local lobby = workspace:FindFirstChild("Lobby")
                local tp1   = lobby and lobby:FindFirstChild("Teleport1")
                if tp1 then touch(tp1) end
            end
        else
            sinceTouch = 0
        end

        if entered and not wasEntered then
            if cfg.tpDelay > 0 then task.wait(cfg.tpDelay) end
            if cfg.autoTP then teleportNow() end
            if cfg.freeze then applyFreeze() end
            armReset()
        end
        wasEntered = entered
    end
end)

task.spawn(function()
    while gui.Parent do
        if cfg.spam and #cfg.keys > 0 and not mouseOverGui() and not UIS:GetFocusedTextBox() then
            for _, k in ipairs(cfg.keys) do pcall(send, k, true) end
            task.wait(0.01)
            for _, k in ipairs(cfg.keys) do pcall(send, k, false) end
            task.wait(cfg.interval)
        else
            task.wait(0.1)
        end
    end
end)

task.spawn(function()
    while gui.Parent do
        task.wait(0.25)
        if cfg.autoReset and resetAt and os.clock() >= resetAt then
            resetAt = nil
            resetCharacter()
        end
    end
end)

updatePlatform()
