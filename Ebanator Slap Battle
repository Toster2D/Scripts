local refreshers = {}

local function mkToggle(page, text, key, onChange)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = C.card
    b.BorderSizePixel  = 0
    b.AutoButtonColor  = false
    b.Parent           = page
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

    -- Иконка-метка слева
    local dot = Instance.new("Frame")
    dot.Size             = UDim2.fromOffset(4, 20)
    dot.Position         = UDim2.fromOffset(8, 8)
    dot.BackgroundColor3 = C.sub
    dot.BorderSizePixel  = 0
    dot.Parent           = b
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 2)

    local lbl = Instance.new("TextLabel")
    lbl.Size           = UDim2.new(1, -80, 1, 0)
    lbl.Position       = UDim2.fromOffset(18, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text           = text
    lbl.TextColor3     = C.txt
    lbl.Font           = Enum.Font.Gotham
    lbl.TextSize       = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent         = b

    -- Пилюля-переключатель справа
    local pill = Instance.new("Frame")
    pill.Size             = UDim2.fromOffset(44, 22)
    pill.Position         = UDim2.new(1, -52, 0.5, -11)
    pill.BackgroundColor3 = C.border
    pill.BorderSizePixel  = 0
    pill.Parent           = b
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.fromOffset(16, 16)
    knob.Position         = UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = C.sub
    knob.BorderSizePixel  = 0
    knob.Parent           = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function refresh()
        local on = cfg[key]
        dot.BackgroundColor3  = on and C.green or C.sub
        pill.BackgroundColor3 = on and C.green or C.border
        knob.BackgroundColor3 = Color3.new(1,1,1)
        knob.Position         = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
        b.BackgroundColor3    = on and Color3.fromRGB(18, 30, 22) or C.card
    end
    refreshers[key] = refresh

    b.MouseButton1Click:Connect(function()
        cfg[key] = not cfg[key]
        refresh()
        if onChange then onChange(cfg[key]) end
    end)
    refresh()
    return b
end

local function mkButton(page, text, color, cb)
    local b = Instance.new("TextButton")
