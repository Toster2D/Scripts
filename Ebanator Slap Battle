    local k = parseKeys(keysBox.Text)
    if #k > 0 then cfg.keys = k end
    keysBox.Text = table.concat(cfg.keys, "+")
end)

local bindBtn
bindBtn = mkButton(p3, "➕  Добавить клавишу нажатием", C.card, function()
    bindBtn.Text = "⌨  Нажми клавишу..."
    local conn
    conn = UIS.InputBegan:Connect(function(input)
        local name
        if input.UserInputType == Enum.UserInputType.Keyboard then
            name = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            name = "LMB"
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            name = "RMB"
        end
        if name then
            conn:Disconnect()
            if not table.find(cfg.keys, name) then table.insert(cfg.keys, name) end
            keysBox.Text = table.concat(cfg.keys, "+")
            bindBtn.Text = "➕  Добавить клавишу нажатием"
        end
    end)
end)

mkButton(p3, "🗑  Очистить клавиши", C.card, function()
    cfg.keys = {}
    keysBox.Text = ""
end)

mkSep(p3)
