local function switchTab(i)
    activeTab = i
    for j, b in ipairs(tabBtns) do
        b.BackgroundColor3 = (j == i) and C.tabOn or Color3.fromRGB(0,0,0)
        b.BackgroundTransparency = (j == i) and 0 or 1
        b.TextColor3 = (j == i) and C.txt or C.sub
